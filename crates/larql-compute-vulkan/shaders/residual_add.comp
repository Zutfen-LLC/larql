// Residual add compute shader (GLSL / Vulkan).
//
// out[i] = a[i] + b[i]. Element-wise; one invocation per element.
//
// Used to add the FFN output back into the residual stream after the
// down projection (and, when attention lands, after attention too).
//
// No push constants needed.

#version 450 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly restrict buffer ABlock { float a[]; };
layout(set = 0, binding = 1) readonly restrict buffer BBlock { float b[]; };
layout(set = 0, binding = 2) writeonly buffer OutBlock { float out_vals[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= a.length()) {
        return;
    }
    out_vals[i] = a[i] + b[i];
}
